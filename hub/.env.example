# Copie para .env.local e preencha a senha MQTT do usuario hub no EMQX.
# EMQX Serverless: aplicativo via WSS :8084/mqtt; ESP32 via TLS :8883.
# Host sem protocolo, porta ou caminho. Gera wss://HOST:8884/mqtt.
EXPO_PUBLIC_HIVEMQ_HOST=
# Se preenchida, esta URL tem prioridade sobre HIVEMQ_HOST.
# Copie a TLS WebSocket URL de Overview para usar outro endpoint/porta.
# Mosquitto local continua aceito: ws://192.168.0.100:9001
EXPO_PUBLIC_MQTT_URL=wss://n60f1e67.ala.us-east-1.emqxsl.com:8084/mqtt
EXPO_PUBLIC_MQTT_TOPIC=casa/sensores
EXPO_PUBLIC_MQTT_USERNAME=hub
EXPO_PUBLIC_MQTT_PASSWORD=senai

# Development shows the simulation button automatically.
# Set true in a homologation build to enable it; keep false in production.
EXPO_PUBLIC_ENABLE_SENSOR_SIMULATION=false
