# Copy to .env.local. Use the computer's Wi-Fi IPv4, not the ESP32 IP.
EXPO_PUBLIC_MQTT_URL=ws://192.168.0.100:9001
EXPO_PUBLIC_MQTT_TOPIC=casa/sensores
EXPO_PUBLIC_MQTT_USERNAME=hub
EXPO_PUBLIC_MQTT_PASSWORD=

# Development shows the simulation button automatically.
# Set true in a homologation build to enable it; keep false in production.
EXPO_PUBLIC_ENABLE_SENSOR_SIMULATION=false
