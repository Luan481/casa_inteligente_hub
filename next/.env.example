# Para reaproveitar hub/.env.local, execute npm run config:app.
# Use uma conta MQTT restrita à leitura: NEXT_PUBLIC_* é visível no navegador.
NEXT_PUBLIC_MQTT_URL=wss://n60f1e67.ala.us-east-1.emqxsl.com:8084/mqtt
NEXT_PUBLIC_MQTT_TOPIC=casa/sensores
NEXT_PUBLIC_MQTT_USERNAME=hub
NEXT_PUBLIC_MQTT_PASSWORD=
# real ou simulation; sem configuração local, o site começa em simulação.
NEXT_PUBLIC_SENSOR_MODE=simulation
